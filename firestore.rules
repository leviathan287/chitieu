rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Global safety net: default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Primitive Helpers ---
    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidDateString(d) {
      return d is string
        && d.size() == 10
        && d.matches('^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$');
    }

    function isValidCategory(c) {
      return c is string
        && c.size() >= 1
        && c.size() <= 32
        && c in ['Ăn uống', 'Mua sắm', 'Học phí', 'Du lịch', 'Thể thao', 'Khác'];
    }

    // --- Entity Validation Blueprint: Bill ---
    function isValidBillShape(data) {
      return data.keys().hasAll(['userId', 'name', 'amount', 'date', 'category', 'isPaid', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['userId', 'name', 'amount', 'date', 'category', 'isPaid', 'createdAt', 'updatedAt'])
        && isValidId(data.userId)
        && data.userId == request.auth.uid
        && data.name is string
        && data.name.size() >= 1
        && data.name.size() <= 120
        && (data.amount is int || data.amount is float)
        && data.amount > 0
        && data.amount <= 1000000000000
        && isValidDateString(data.date)
        && isValidCategory(data.category)
        && data.isPaid is bool
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidBillCreate() {
      return isValidBillShape(incoming())
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
    }

    function isValidBillUpdate() {
      return isValidBillShape(incoming())
        && incoming().userId == existing().userId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          incoming().diff(existing()).affectedKeys().hasOnly(['isPaid', 'category', 'updatedAt']) ||
          incoming().diff(existing()).affectedKeys().hasOnly(['name', 'amount', 'date', 'category', 'isPaid', 'updatedAt'])
        );
    }

    // --- Collection: bills ---
    match /bills/{billId} {
      allow get: if isVerifiedUser()
        && isValidId(billId)
        && existing().userId == request.auth.uid;

      allow list: if isVerifiedUser()
        && resource.data.userId == request.auth.uid;

      allow create: if isVerifiedUser()
        && isValidId(billId)
        && isValidBillCreate();

      allow update: if isVerifiedUser()
        && isValidId(billId)
        && existing().userId == request.auth.uid
        && isValidBillUpdate();

      allow delete: if isVerifiedUser()
        && isValidId(billId)
        && existing().userId == request.auth.uid;
    }
  }
}
